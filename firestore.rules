rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function emailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Use the email directly for the initial setup as specified in instructions
      return isSignedIn() && (
        request.auth.token.email == 'leaninkclothing@gmail.com' ||
        request.auth.token.email == 'rudrapable2010@gmail.com' ||
        get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helpers
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt', 'displayName']) &&
             data.uid == request.auth.uid &&
             data.email == request.auth.token.email &&
             data.role in ['student', 'admin'] &&
             data.createdAt == request.time;
    }

    function isValidSubject(data) {
      return data.keys().hasAll(['name', 'order']) &&
             data.name is string && data.name.size() <= 100 &&
             data.order is number;
    }

    function isValidChapter(data) {
      return data.keys().hasAll(['subjectId', 'name', 'order']) &&
             data.subjectId is string && data.name is string && data.order is number;
    }

    function isValidQuestion(data) {
      return data.keys().hasAll(['chapterId', 'subjectId', 'type', 'questionText', 'correctAnswer', 'explanation']) &&
             data.questionText is string && data.questionText.size() <= 10000 &&
             data.type == 'mcq' &&
             (data.chapterId is string || data.chapterId == 'none') &&
             (data.keys().hasAll(['options']) ? data.options is list && data.options.size() == 4 : true);
    }

    function isValidTestResult(data) {
      return data.keys().hasAll(['studentId', 'score', 'timestamp', 'totalQuestions', 'correctAnswers', 'wrongAnswers', 'accuracy', 'subjectId', 'chapterId', 'testType']) &&
             data.studentId == request.auth.uid &&
             data.timestamp == request.time &&
             (data.chapterId is string || data.chapterId == 'mock') &&
             (data.keys().hasAll(['studentEmail']) ? (data.studentEmail is string || data.studentEmail == null) : true) &&
             (data.keys().hasAll(['subjectName']) ? data.subjectName is string : true) &&
             (data.keys().hasAll(['testTitle']) ? data.testTitle is string : true) &&
             (data.keys().hasAll(['answers']) ? data.answers is list : true);
    }

    function isValidMockTest(data) {
      return data.keys().hasAll(['title', 'subjectId', 'questionIds', 'duration']) &&
             data.title is string && data.title.size() <= 200 &&
             data.questionIds is list && data.questionIds.size() > 0 &&
             data.duration is number;
    }

    // Rules for User Profiles
    match /user_profiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && isValidUserProfile(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && (
        // Only admin can change role
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'displayName'])) ||
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName']) && incoming().role == existing().role)
      );
    }

    // Rules for Subjects (Public Read, Admin Write)
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidSubject(incoming());
      allow delete: if isAdmin();
    }

    // Rules for Chapters (Public Read, Admin Write)
    match /chapters/{chapterId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidChapter(incoming());
      allow delete: if isAdmin();
    }

    // Rules for Questions (Public Read, Admin Write)
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidQuestion(incoming());
      allow delete: if isAdmin();
    }

    // Rules for Test Results (Student Read/Write, Admin Read)
    match /test_results/{resultId} {
      allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidTestResult(incoming());
      allow update, delete: if isAdmin();
    }

    // Rules for Mock Tests (Public Read, Admin Write)
    match /mock_tests/{testId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidMockTest(incoming());
      allow delete: if isAdmin();
    }
  }
}
